{
  "version": 2,
  "name": "经典后台",
  "colors": {
    "primary": "#4188FF",
    "success": "#52C41A",
    "warning": "#FAAD14",
    "error": "#FF4D4F",
    "text": "#1E1E1E",
    "muted": "#696C70",
    "placeholder": "#BFBFBF",
    "border": "#D9D9D9",
    "divider": "#F0F0F0",
    "page": "#F5F5F5",
    "surface": "#FFFFFF"
  },
  "typography": {
    "family": "'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif",
    "size": 14,
    "lineHeight": 22,
    "titleSize": 18,
    "titleWeight": 500,
    "helperSize": 12,
    "drawerTitleSize": 16
  },
  "layout": {
    "pagePadding": 16,
    "pageGap": 8,
    "cardPadding": 12,
    "scrollMode": "table"
  },
  "navigation": {
    "mode": "dark",
    "width": 200,
    "collapsedWidth": 80,
    "itemHeight": 40,
    "showBrand": true,
    "brand": "形影随拍管理后台",
    "subtitle": "租户 ID",
    "darkBackground": "#101318",
    "darkSubmenu": "#171C24",
    "darkItemText": "#D9DEE7",
    "darkText": "#FFFFFF",
    "darkMuted": "#AAB1BD"
  },
  "header": {
    "visible": true,
    "height": 64,
    "background": "#F5F5F5",
    "showAccount": true,
    "border": false
  },
  "controls": {
    "height": 32,
    "radius": 2,
    "cardRadius": 4,
    "cardShadow": false,
    "queryWidth": 200,
    "queryButtonWidth": 40
  },
  "table": {
    "paddingBlock": 16,
    "paddingInline": 12,
    "headerBackground": "#FAFAFA",
    "headerText": "#696C70",
    "paginationGap": 16
  },
  "form": {
    "itemGap": 8,
    "columnGap": 16,
    "columns": 2,
    "labelPosition": "vertical"
  },
  "drawer": {
    "formWidth": 720,
    "detailWidth": 800,
    "padding": 24,
    "headerHeight": 48,
    "headerTint": true,
    "footerShadow": true
  }
}
