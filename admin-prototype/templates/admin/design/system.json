{
  "version": 3,
  "name": "形影随拍 Figma",
  "colors": {
    "primary": "#2776FF",
    "success": "#52C41A",
    "warning": "#FAAD14",
    "error": "#FF4D4F",
    "text": "#303338",
    "muted": "#696C70",
    "placeholder": "#B3B8BF",
    "border": "#D7DAE0",
    "divider": "#E9EBF0",
    "page": "#F2F4F7",
    "surface": "#FFFFFF",
    "helper": "#8F9499",
    "input": "#FFFFFF",
    "primaryLight": "#E6ECFF",
    "primaryBorder": "#91D5FF",
    "successBg": "#F6FFED",
    "successBorder": "#B7EB8F",
    "warningBg": "#FFFBE6",
    "warningBorder": "#FFE58F",
    "errorBg": "#FFF1F0",
    "errorBorder": "#FF7875"
  },
  "typography": {
    "family": "'HarmonyOS Sans SC', 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif",
    "size": 14,
    "lineHeight": 22,
    "titleSize": 18,
    "titleWeight": 500,
    "helperSize": 14,
    "drawerTitleSize": 16
  },
  "layout": {
    "pagePadding": 24,
    "pageGap": 16,
    "cardPadding": 24,
    "scrollMode": "table"
  },
  "navigation": {
    "mode": "dark",
    "width": 220,
    "collapsedWidth": 80,
    "itemHeight": 40,
    "showBrand": true,
    "brand": "形影随拍管理后台",
    "subtitle": "租户 ID",
    "darkBackground": "#000000",
    "darkSubmenu": "#171C24",
    "darkItemText": "#D9DEE7",
    "darkText": "#FFFFFF",
    "darkMuted": "#AAB1BD"
  },
  "header": {
    "visible": true,
    "height": 58,
    "background": "#FFFFFF",
    "showAccount": true,
    "border": true
  },
  "controls": {
    "height": 32,
    "radius": 2,
    "cardRadius": 8,
    "cardShadow": false,
    "queryWidth": 200,
    "queryButtonWidth": 40
  },
  "table": {
    "paddingBlock": 13,
    "paddingInline": 12,
    "headerBackground": "#FAFAFA",
    "headerText": "#8F9499",
    "paginationGap": 16
  },
  "form": {
    "itemGap": 16,
    "columnGap": 16,
    "columns": 1,
    "labelPosition": "vertical"
  },
  "drawer": {
    "formWidth": 600,
    "detailWidth": 800,
    "padding": 24,
    "headerHeight": 56,
    "headerTint": true,
    "footerShadow": true
  }
}
