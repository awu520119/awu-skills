{
  "name": "admin-prototype-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "design:check": "node scripts/design-check.mjs",
    "check": "tsc --noEmit",
    "build": "npm run design:check && tsc --noEmit && vite build",
    "publish:viewer": "npm run build && node scripts/publish-to-viewer.mjs",
    "export:html": "npm run build && node scripts/inline-share.mjs",
    "format": "prettier --write src scripts design vite.config.ts",
    "format:check": "prettier --check src scripts design vite.config.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  }
}
